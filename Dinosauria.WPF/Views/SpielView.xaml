<UserControl x:Class="Dinosauria.WPF.Views.SpielView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->
        <Grid Margin="4,0,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="DINOSAURIA"
                       Style="{StaticResource GameLogoText}"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="1" Style="{StaticResource HeaderSeparator}"/>

            <TextBlock Grid.Column="2"
                       Text="{Binding Spielername, StringFormat='Spieler: {0}'}"
                       Style="{StaticResource GameHeaderText}"/>

            <Border Grid.Column="3" Style="{StaticResource HeaderSeparator}"/>

            <TextBlock Grid.Column="4"
                       Text="{Binding Fossilien, StringFormat='Fossilien: {0:N0}'}"
                       Style="{StaticResource GameHeaderText}"/>

            <Border Grid.Column="5"
                    BorderThickness="0"
                    Background="Transparent"/>

            <StackPanel Grid.Column="6"
                        VerticalAlignment="Center"
                        Margin="12,0,20,0">
                <TextBlock Text="{Binding SpielzielName, StringFormat='Ziel: {0}'}"
                           Style="{StaticResource GameHeaderText}"/>
            </StackPanel>

            <Button Grid.Column="7"
                    Content="Hauptmen&#252;"
                    Style="{StaticResource AppButton}"
                    Margin="0"
                    Padding="16,6"
                    Click="Hauptmenue_Click"/>
        </Grid>

        <!-- Spielfeld -->
        <Border Grid.Row="1"
                Style="{StaticResource GamePanelBorder}"
                Margin="0,0,0,4">
            <Canvas Background="{StaticResource GameFieldBrush}"/>
        </Border>

        <!-- Verschiebbarer horizontaler Trenner -->
        <GridSplitter Grid.Row="2"
                      Style="{StaticResource GameGridSplitter}"/>

        <!-- Unterer Bereich -->
        <Grid Grid.Row="3" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Tabellen -->
            <Border Style="{StaticResource GamePanelBorder}"
                    Margin="0,0,8,0">
                <TabControl Style="{StaticResource GameTabControl}">

                    <TabItem Header="Dinosaurier">
                        <DataGrid ItemsSource="{Binding DinosaurierListe}"
                                  Style="{StaticResource AppDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Dinosaurierart.Name}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Anzahl"
                                                    Binding="{Binding Anzahl}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Produktion / Sek."
                                                    Binding="{Binding Dinosaurierart.ProduktionProSekunde}"
                                                    Width="1.5*"/>

                                <DataGridTemplateColumn Header="Aktion" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Kaufen"
                                                    Style="{StaticResource SmallAppButton}"
                                                    IsEnabled="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Karten">
                        <DataGrid ItemsSource="{Binding KartenListe}"
                                  Style="{StaticResource AppDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Karte.Name}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Dinosaurierart"
                                                    Binding="{Binding Karte.Dinosaurierart.Name}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Multiplikator"
                                                    Binding="{Binding Karte.Multiplikator}"
                                                    Width="*"/>

                                <DataGridTemplateColumn Header="Aktion" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Kaufen"
                                                    Style="{StaticResource SmallAppButton}"
                                                    IsEnabled="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- Detailbereich -->
            <Border Grid.Column="1"
                    Style="{StaticResource GamePanelBorder}"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Details"
                               Style="{StaticResource DetailTitleText}"/>

                    <Separator Margin="0,8,0,12"
                               Background="{StaticResource PanelBorderBrush}"/>

                    <TextBlock Text="Waehle einen Dinosaurier oder eine Karte aus."
                               Style="{StaticResource DetailText}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="4"
                Style="{StaticResource GameStatusBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Spielzeit: 00:00:00"
                           Style="{StaticResource GameStatusText}"/>

                <Border Style="{StaticResource HeaderSeparator}"/>

                <TextBlock Text="Gesamt produzierte Fossilien: 0"
                           Style="{StaticResource GameStatusText}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
