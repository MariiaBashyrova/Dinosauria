<UserControl x:Class="Dinosauria.WPF.Views.SpielView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">
    
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->
        <Grid Margin="4,0,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="DINOSAURIA"
                       Style="{StaticResource GameLogoText}"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="1" Style="{StaticResource HeaderSeparator}"/>

            <TextBlock Grid.Column="2"
                       Text="{Binding Spielername, StringFormat='Spieler: {0}'}"
                       Style="{StaticResource GameHeaderText}"/>

            <Border Grid.Column="3" Style="{StaticResource HeaderSeparator}"/>

            <TextBlock Grid.Column="4"
                       Text="{Binding Fossilien, StringFormat='Fossilien: {0:N0}'}"
                       Style="{StaticResource GameHeaderText}"/>
            <Border Grid.Column="5" Style="{StaticResource HeaderSeparator}"/>

            <TextBlock Grid.Column="6"    Text="{Binding GesamtProduktion, StringFormat='Produktion: +{0:N2} / Sek.'}"      Style="{StaticResource GameHeaderText}"/>


            <StackPanel Grid.Column="7"
            VerticalAlignment="Center"
            Margin="12,0,20,0">
                <TextBlock Text="{Binding SpielzielName, StringFormat='Ziel: {0}'}"
               Style="{StaticResource GameHeaderText}"/>

                <ProgressBar Value="{Binding SpielzielFortschritt, Mode=OneWay}"
             Maximum="100"
             Height="6"
             Width="140"
             Margin="0,4,0,0"/>

                <TextBlock Text="{Binding SpielzielFortschrittText}"
               Style="{StaticResource GameHeaderText}"/>
            </StackPanel>

            <Button Grid.Column="8"
                    Content="Hauptmen&#252;"
                    Style="{StaticResource AppButton}"
                    Margin="0"
                    Padding="16,6"
                    Click="Hauptmenue_Click"/>
        </Grid>

        <!-- Spielfeld -->
        <Border Grid.Row="1"
                Style="{StaticResource GamePanelBorder}"
                Margin="0,0,0,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              CanContentScroll="False"
              HorizontalContentAlignment="Left"
              VerticalContentAlignment="Top">
                <Canvas x:Name="SpielfeldCanvas"
            MinWidth="800"
            MinHeight="260" 
            Background="Transparent"
            ClipToBounds="True"/>
            </ScrollViewer>

        </Border>

        <!-- Verschiebbarer horizontaler Trenner -->
        <GridSplitter Grid.Row="2"
                      Style="{StaticResource GameGridSplitter}"/>

        <!-- Unterer Bereich -->
        <Grid Grid.Row="3" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Tabellen -->
            <Border Style="{StaticResource GamePanelBorder}"
                    Margin="0,0,8,0">
                <TabControl Style="{StaticResource GameTabControl}" SelectedIndex="{Binding AktiveTabelle, Mode=TwoWay}">

                    <TabItem Header="Dinosaurier">
                        <DataGrid ItemsSource="{Binding DinosaurierListe}" SelectedItem="{Binding AusgewaehlterDinosaurier}"
                                  Style="{StaticResource AppDataGrid}" x:Name="DinosaurierDataGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"  Binding="{Binding Name}"  ElementStyle="{StaticResource DataGridTextStyle}" Width="2*"/>

                                <DataGridTextColumn Header="Anzahl"   Binding="{Binding Anzahl}" ElementStyle="{StaticResource DataGridTextStyle}" Width="*"/>

                                <DataGridTextColumn Header="Produktion / Sek."  Binding="{Binding ProduktionProSekunde, StringFormat={}{0:N2}}" ElementStyle="{StaticResource DataGridTextStyle}" Width="1.5*"/>

                                <DataGridTextColumn Header=" + pro Kauf"  Binding="{Binding proKauf}" ElementStyle="{StaticResource DataGridTextStyle}" Width="*"/>

                                <DataGridTextColumn Header="Kosten"  Binding="{Binding Kosten, StringFormat={}{0:N2}}" ElementStyle="{StaticResource DataGridTextStyle}" Width="*"/>

                                <DataGridTemplateColumn Header="Aktion" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Kaufen" Command="{Binding KaufenCommand}"
                                                    Style="{StaticResource SmallAppButton}"
                                                    />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IstGekauft}" Value="True">
                                            <Setter Property="Background" Value="#DDF2DD"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Karten">
                        <DataGrid ItemsSource="{Binding KartenListe}" SelectedItem="{Binding AusgewaehlteKarte}"
                                  Style="{StaticResource AppDataGrid}" x:Name="KartenDataGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"  ElementStyle="{StaticResource DataGridTextStyle}"
                                                    Binding="{Binding Name}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Dinosaurierart"  ElementStyle="{StaticResource DataGridTextStyle}"
                                                    Binding="{Binding Dinosaurierart.Name}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Multiplikator"  ElementStyle="{StaticResource DataGridTextStyle}"
                                                    Binding="{Binding Multiplikator, StringFormat=N1}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Kosten"  ElementStyle="{StaticResource DataGridTextStyle}"
                                                    Binding="{Binding Kosten, StringFormat=N2}"  Width="*"/>
                                <DataGridTemplateColumn Header="Aktion" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding KarteKaufenCommandContent}" Command="{Binding KarteKaufenCommand}" Style="{StaticResource SmallAppButton}"    />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IstGekauft}" Value="True">
                                            <Setter Property="Background" Value="#DDF2DD"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- Detailbereich -->
            <Border Grid.Column="1"
                    Style="{StaticResource GamePanelBorder}"
                    Padding="14">
                
                    

                    <!-- Dinosaurier-Details -->
                <ScrollViewer 
   VerticalScrollBarVisibility="Auto"
   CanContentScroll="False"
   HorizontalContentAlignment="Left"
   VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Details"
               Style="{StaticResource DetailTitleText}"/>

                        <Separator Margin="0,8,0,12"
               Background="{StaticResource PanelBorderBrush}"/>

                        <!-- Dinosaurier-Details -->
                        <StackPanel DataContext="{Binding AusgewaehlterDinosaurier}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.AktiveTabelle,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding Name}"
                   Style="{StaticResource DetailTitleText}"/>

                            <TextBlock Text="{Binding Dinosaurier.Dinosaurierart.Beschreibung}"
                   Style="{StaticResource DetailText}"
                   TextWrapping="Wrap"/>

                            <Separator Margin="0,8,0,8"/>

                            <TextBlock Text="{Binding Anzahl, StringFormat=Anzahl: {0}}"
                   Style="{StaticResource DetailText}"/>

                            <TextBlock Text="{Binding ProduktionProSekunde, StringFormat=Produktion / Sek.: {0:N2}}"
                   Style="{StaticResource DetailText}"/>

                            <TextBlock Text="{Binding proKauf, StringFormat=Zuwachs pro Kauf: {0}}"
                   Style="{StaticResource DetailText}"/>

                            <TextBlock Text="{Binding Kosten, StringFormat=Kosten: {0:N2} Fossilien}"
                   Style="{StaticResource DetailText}"/>

                            <Separator Margin="0,8,0,8"/>

                            <TextBlock Text="{Binding Dinosaurier.Dinosaurierart.Erdzeitalter, StringFormat=Epoche: {0}}"
                   Style="{StaticResource DetailText}"/>

                            <TextBlock Text="{Binding Dinosaurier.Dinosaurierart.Ernaehrung, StringFormat=Ernaehrung: {0}}"
                   Style="{StaticResource DetailText}"/>

                            <TextBlock Text="{Binding Dinosaurier.Dinosaurierart.Lebensraum, StringFormat=Lebensraum: {0}}"
                   Style="{StaticResource DetailText}"/>
                        </StackPanel>

                        <!-- Karten-Details -->
                        <StackPanel DataContext="{Binding AusgewaehlteKarte}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.AktiveTabelle,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding Karte.Karte.Name}"
                   Style="{StaticResource DetailTitleText}"/>

                            <TextBlock Text="{Binding Karte.Karte.Beschreibung}"
                   Style="{StaticResource DetailText}"
                   TextWrapping="Wrap"/>

                            <Separator Margin="0,8,0,8"/>

                            <TextBlock Text="{Binding Karte.Karte.Dinosaurierart.Name, StringFormat=Dinosaurier: {0}}"
                   Style="{StaticResource DetailText}"/>

                            <TextBlock Text="{Binding Karte.Karte.Multiplikator, StringFormat=Multiplikator: *{0}}"
                   Style="{StaticResource DetailText}"/>

                            <TextBlock Text="{Binding Karte.Karte.Kaufkosten, StringFormat=Kosten: {0:N2} Fossilien}"
                   Style="{StaticResource DetailText}"/>
                        </StackPanel>

                        <!-- Keine Auswahl -->
                        <TextBlock Text="Waehle einen Dinosaurier oder eine Karte aus."            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding AusgewaehlterDinosaurier}" Value="{x:Null}"/>
                                                <Condition Binding="{Binding AusgewaehlteKarte}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="4"
                Style="{StaticResource GameStatusBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Spielzeit, StringFormat='Spielzeit: {0}'}"
               Style="{StaticResource GameStatusText}"/>

                <Border Style="{StaticResource HeaderSeparator}"/>

                <TextBlock Text="{Binding GesamtProduziert, StringFormat='Gesamt produzierte Fossilien: {0:N0}'}"
               Style="{StaticResource GameStatusText}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
