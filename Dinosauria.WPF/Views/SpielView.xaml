<UserControl x:Class="Dinosauria.WPF.Views.SpielView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Spiel&#252;bersicht" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Spieler: -" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Hauptmen&#252;" Style="{StaticResource AppButton}" Padding="16,8" Margin="0" Click="Hauptmenue_Click" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#FFDDE8D5" Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Fossilien" Style="{StaticResource SectionLabelText}" />
                    <TextBlock Text="0" Style="{StaticResource MetricValueText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#FFE9E1CE" Style="{StaticResource MetricCard}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Produktion pro Sekunde" Style="{StaticResource SectionLabelText}" />
                    <TextBlock Text="0" Style="{StaticResource MetricValueText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#FFD9E5E5" Style="{StaticResource MetricCard}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Spielziel" Style="{StaticResource SectionLabelText}" />
                    <TextBlock Text="Fossiliensammler" Style="{StaticResource MetricValueText}" FontSize="18" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox Header="Spielfeld" Style="{StaticResource PanelGroupBox}" Margin="0,0,0,14">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas MinWidth="700" MinHeight="280" Background="#FFF0E8D8">
                        <Ellipse Width="110" Height="110" Fill="#FFB7C9B0" Stroke="#FF314E41" StrokeThickness="2" Canvas.Left="80" Canvas.Top="70" />
                        <TextBlock Text="Dinosaurier" Canvas.Left="101" Canvas.Top="112" Foreground="{StaticResource PrimaryBrush}" />
                        <Rectangle Width="150" Height="72" Fill="#FFC8D8E8" Stroke="#FF314E41" StrokeThickness="2" Canvas.Left="330" Canvas.Top="88" />
                        <TextBlock Text="Karte" Canvas.Left="385" Canvas.Top="113" Foreground="{StaticResource PrimaryBrush}" />
                        <Line X1="190" Y1="125" X2="330" Y2="125" Stroke="{StaticResource SecondaryBrush}" StrokeThickness="2" />
                    </Canvas>
                </ScrollViewer>
            </GroupBox>
            <TabControl Grid.Row="1">
                <TabItem Header="Dinosaurier">
                    <DataGrid Style="{StaticResource AppDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Dinosaurierart.Name}" />
                            <DataGridTextColumn Header="Anzahl" Binding="{Binding Anzahl}" />
                            <DataGridTextColumn Header="Produktion/Sek." Binding="{Binding Dinosaurierart.ProduktionProSekunde}" />
                            <DataGridTemplateColumn Header="Aktion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="Kaufen" Style="{StaticResource AppButton}" Padding="10,4" Margin="0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Karten">
                    <DataGrid Style="{StaticResource AppDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Karte.Name}" />
                            <DataGridTextColumn Header="Dinosaurierart" Binding="{Binding Karte.Dinosaurierart.Name}" />
                            <DataGridTextColumn Header="Multiplikator" Binding="{Binding Karte.Multiplikator}" />
                            <DataGridTemplateColumn Header="Aktion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="Kaufen" Style="{StaticResource AppButton}" Padding="10,4" Margin="0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
        <StatusBar Grid.Row="3" Style="{StaticResource AppStatusBar}" Margin="0,14,0,0">
            <StatusBarItem Content="Spielzeit: 00:00:00" />
            <Separator />
            <StatusBarItem Content="Gesamtproduktion: 0" />
        </StatusBar>
    </Grid>
</UserControl>
