<UserControl x:Class="Dinosauria.WPF.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelHeaderBrush}"
                Padding="14,4">
            <TextBlock Text="DINOSAURIA"
                       Style="{StaticResource PageTitleText}"/>
        </Border>

        <!-- Spieler und Rangliste -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Spieler auswaehlen -->
            <Border Style="{StaticResource PanelBorder}"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Spieler ausw&#228;hlen"
                                   Style="{StaticResource PanelHeaderText}"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding SpielerListe}"
                                 SelectedItem="{Binding AusgewaehlterSpieler}"
                                 DisplayMemberPath="Name"
                                 Style="{StaticResource PlayerListBox}"
                                 Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBox Text="{Binding NeuerSpielerName, UpdateSourceTrigger=PropertyChanged}"
             Height="36"
             Margin="0,0,0,8"
             Padding="6"
             VerticalContentAlignment="Center"/>

                            <Button Content="Neuer Spieler"
            Command="{Binding SpielerHinzufuegenCommand}"
            Style="{StaticResource AppButton}"/>

                            <Button Content="Umbenennen"  Command="{Binding SpielerUmbenennenCommand}"
            Style="{StaticResource AppButton}"/>

                            <Button Content="Spieler l&#246;schen" Command="{Binding SpielerLoeschenCommand}"
            Style="{StaticResource AppButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Rangliste -->
            <Border Grid.Column="1"
                    Style="{StaticResource PanelBorder}"
                    Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Rangliste"
                                   Style="{StaticResource PanelHeaderText}"/>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Rangliste}"
                              Style="{StaticResource AppDataGrid}"
                              Margin="16"
                              IsReadOnly="True"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Platz"
                                                Binding="{Binding Platz}"
                                                Width="0.5*"/>
                            <DataGridTextColumn Header="Spieler"
                                                Binding="{Binding Spielername}"
                                                Width="1.2*"/>
                            <DataGridTextColumn Header="Bestzeit"
                                                Binding="{Binding Bestzeit}"
                                                Width="1.2*"/>
                            <DataGridTextColumn Header="Abgeschlossene Spiele"
                                                Binding="{Binding AnzahlSpiele}"
                                                Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Horizontaler GridSplitter -->
        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#FFD0D5DC"
                      ShowsPreview="True"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Spiele des ausgewaehlten Spielers -->
        <Border Grid.Row="3"
                Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelHeader}">
                    <TextBlock Text="{Binding SpielerSpieleTitel}"
                               Style="{StaticResource PanelHeaderText}"/>
                </Border>

                <DataGrid Grid.Row="1"
              ItemsSource="{Binding SpielerSpiele}"
              Style="{StaticResource AppDataGrid}"
              Margin="12"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserResizeRows="False"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              RowHeaderWidth="0"
              AlternationCount="2">
                    <DataGrid.Columns>
                        
                        <DataGridTextColumn Header="Spielstand"
                                            Binding="{Binding SpielID, StringFormat=Spiel {0}}"
                                            Width="1*"/>
                        <DataGridTextColumn Header="Startdatum"
                                            Binding="{Binding Startzeitpunkt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                            Width="1.3*"/>
                        <DataGridTextColumn Header="Spielzeit"
                                            Binding="{Binding Abschlussdauer, StringFormat={}{0:hh\\:mm\\:ss}}"
                                            Width="1*"/>
                        <DataGridTextColumn Header="Produzierte Fossilien"
                                            Binding="{Binding GesamtProduziert, StringFormat=N0}"
                                            Width="1.4*"/>
                        <DataGridTextColumn Header="Freigeschaltete Dinosaurier"
                                            Binding="{Binding FreigeschalteteDinosaurier}"
                                            Width="1.6*"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Aktionen -->
        <Grid Grid.Row="4" Margin="12,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Neues Spiel starten"
                    Command="{Binding NeuesSpielStartenCommand}"
                    Style="{StaticResource PrimaryButton}" Cursor="Hand"/>

            <Button Grid.Column="1"
                    Content="Spiel fortsetzen"
                    Style="{StaticResource AppButton}"/>

            <Button Grid.Column="2"
                    Content="Spiel l&#246;schen"
                    Style="{StaticResource AppButton}"/>

            <Button Grid.Column="4"
                    Content="Beenden"
                    Style="{StaticResource AppButton}"/>
        </Grid>
    </Grid>
</UserControl>
